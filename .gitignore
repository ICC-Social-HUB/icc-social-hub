# ========================================================
# Git Ignore Rules — ICC Social Hub
# ========================================================

# Dependencies
node_modules/
backend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json.backup

# Environment Variables & Secrets (CRITICAL)
.env
.env.*
!.env.example
backend/.env
!backend/.env.example
*.pem
*.key
*.cert
*.crt
*.p12

# Firebase & Cloud Credentials
google-services.json
firebase-adminsdk*.json
service-account*.json

# Operating System & IDE Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Local Development & Scratch Scripts
scratch/
wipe_notification.js
local-test*.js

# Vercel & Web Deployments
.vercel/
dist/
build/

# Android Build & Native Artifacts
android/.gradle/
android/build/
android/app/build/
android/.idea/
android/captures/
android/local.properties
*.keystore
!android/app/debug.keystore

# Keep only the official release APK tracked
*.apk
!assets/icc-social-hub.apk
!www/assets/icc-social-hub.apk
